{
  "name": "nestjs-demo-app",
  "version": "1.0.0",
  "description": "Small NestJS task API \u2013 the reference example for a series of one-minute videos",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "libs/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "npm run build -w apps/nestjs",
    "start:dev": "npm run start:dev -w apps/nestjs",
    "start:prod": "npm run start:prod -w apps/nestjs",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "oxlint libs/ apps/",
    "format": "prettier --write \"{libs,apps}/**/*.ts\"",
    "format:check": "prettier --check \"{libs,apps}/**/*.ts\""
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "oxlint": "^1.87.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
